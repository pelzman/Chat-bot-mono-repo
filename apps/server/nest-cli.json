{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "assets": [
      {
        "include": "generated/**/*",
        "outDir": "./dist/"
      },
      {
        "include": "face-verification/models/**/*",
        "outDir": "./dist/"
      }
    ],
    "watchAssets": true
  }
}